{
  "$schema": "https://opencode.ai/config.json",
  // Workers (depth 1) may start `lint` and `general` (depth 2); nothing nests deeper.
  "experimental": { "subagent_depth": 2 },
  // Ordered rules; the last match wins. Copied from the frogbot checkout's .opencode; its
  // plugin (which names the alternative) is not loaded here, so these rules are the guard.
  "permissions": [
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git -C * push *", "effect": "deny" },
    { "action": "shell", "resource": "git -c * push *", "effect": "deny" },

    { "action": "shell", "resource": "git *commit *--no-verify*", "effect": "deny" },
    { "action": "shell", "resource": "git *commit -n*", "effect": "deny" },
    { "action": "shell", "resource": "git *commit * -n*", "effect": "deny" },
    { "action": "shell", "resource": "git *commit -an*", "effect": "deny" },
    { "action": "shell", "resource": "git *commit * -an*", "effect": "deny" },

    { "action": "shell", "resource": "git merge *", "effect": "deny" },
    { "action": "shell", "resource": "git -C * merge *", "effect": "deny" },
    { "action": "shell", "resource": "git -c * merge *", "effect": "deny" },

    { "action": "shell", "resource": "sleep *", "effect": "deny" },
    { "action": "shell", "resource": "kill -0 *", "effect": "deny" },

    { "action": "shell", "resource": "pnpm test", "effect": "deny" },
    { "action": "shell", "resource": "pnpm run test", "effect": "deny" },
    { "action": "shell", "resource": "vitest run", "effect": "deny" },
    { "action": "shell", "resource": "pnpm vitest run", "effect": "deny" },
    { "action": "shell", "resource": "pnpm exec vitest run", "effect": "deny" },
    { "action": "shell", "resource": "npx vitest run", "effect": "deny" },
    { "action": "shell", "resource": "playwright test", "effect": "deny" },
    { "action": "shell", "resource": "pnpm exec playwright test", "effect": "deny" },
    { "action": "shell", "resource": "npx playwright test", "effect": "deny" },
    { "action": "shell", "resource": "pnpm test:browser", "effect": "deny" },
    { "action": "shell", "resource": "pnpm run test:browser", "effect": "deny" },

    // Only the primary agents below may start subagents.
    { "action": "subagent", "resource": "*", "effect": "deny" },
  ],
  "agents": {
    "build": {
      "permissions": [{ "action": "subagent", "resource": "*", "effect": "allow" }],
    },
    "plan": {
      "permissions": [{ "action": "subagent", "resource": "*", "effect": "allow" }],
    },
    "general": {
      "permissions": [
        { "action": "subagent", "resource": "lint", "effect": "allow" },
        { "action": "subagent", "resource": "general", "effect": "allow" },
      ],
    },
  },
}
