{
  "name": "sidekick",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "lint": "eslint . --max-warnings=0 --cache --cache-location node_modules/.cache/eslint",
    "lint:fix": "eslint . --fix --max-warnings=0 --cache --cache-location node_modules/.cache/eslint",
    "oxlint": "oxlint --type-aware",
    "prettier": "prettier --check .",
    "prettier:write": "prettier --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "ticket": "node ../frogbot/scripts/ticket.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "^22.10.2",
    "@vitest/eslint-plugin": "^1.1.0",
    "eslint": "^9.16.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^17.8.0",
    "husky": "9.0.11",
    "lint-staged": "15.2.7",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "^3.2.5",
    "typescript": "5.6.2",
    "typescript-eslint": "^8.20.0",
    "vitest": "4.1.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored --cache --cache-location node_modules/.cache/eslint",
      "oxlint --type-aware --no-error-on-unmatched-pattern",
      "prettier --write"
    ],
    "*.{md,json,yml,css}": "prettier --write"
  }
}
